# Environment values override .env, config.yaml, and credential.yaml.
APP_SERVER__HOST=127.0.0.1
APP_SERVER__PORT=8080
APP_SERVER__WORKERS=1
APP_SERVER__THREAD_POOL_TOKENS=40
APP_LOGGING__LEVEL=INFO
APP_REQUEST__MAX_BODY_BYTES=1048576
# true использует local_services/local.sqlite3; false требует database.url из config.yaml.
APP_LOCAL_DEVELOPMENT=true
